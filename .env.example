# =============================================================
# Thailand Railway Digital Twin — Environment Variables
# Copy to .env and adjust values for your setup.
# =============================================================

# ── PostgreSQL (PostGIS) ─────────────────────────────────────
POSTGRES_DB=railway_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres          # CHANGE in production!
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Shared database / Redis URLs ─────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/railway_db
REDIS_URL=redis://redis:6379/0

# ── Simulation (FastAPI) ────────────────────────────────────────
SIMULATION_PORT=8000
SIMULATION_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
SECRET_KEY=dev-secret-key-change-in-production   # CHANGE in production!
RATE_LIMIT_PER_MINUTE=100
WS_HEARTBEAT_INTERVAL=10
POSITION_CACHE_INTERVAL_SECONDS=10
TRAJECTORY_REFRESH_INTERVAL_SECONDS=20

# ── Gateway (FastAPI) ───────────────────────────────────────
GATEWAY_PORT=8002
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://localhost:8002,http://127.0.0.1:3000,http://127.0.0.1:8002
SIMULATION_URL=http://simulation:8000
WS_POLL_INTERVAL=10
TRAJECTORY_POLL_INTERVAL=10

# ── Rail DB Setup ───────────────────────────────────────────
SETUP_PORT=8003

# ── Rail Data Collector ──────────────────────────────────────
COLLECTOR_PORT=8001

# ── Frontend (Next.js) ──────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8002
NEXT_PUBLIC_WS_URL=ws://localhost:8002

# ── General ──────────────────────────────────────────────────
ENVIRONMENT=development
SIMULATION_DEBUG=true
RAILDBSETUP_DEBUG=false
RAILDATACOLLECTOR_DEBUG=false
LOG_LEVEL=INFO

# ── Optional tools (docker compose --profile tools up) ──────
# PGADMIN_PORT=5050
REDIS_COMMANDER_PORT=8081
