# Environment configuration for Thailand Railway Digital Twin Backend

# Application settings
APP_NAME="Thailand Railway Digital Twin"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

# API settings
API_V1_PREFIX=/api/v1

# Security settings (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database settings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/railway_db

# Redis settings (for caching)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=WARNING

# Rate limiting
RATE_LIMIT_PER_MINUTE=100

# WebSocket
WS_HEARTBEAT_INTERVAL=30
POSITION_CACHE_INTERVAL_SECONDS=5
TRAJECTORY_REFRESH_INTERVAL_SECONDS=20
