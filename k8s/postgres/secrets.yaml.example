apiVersion: v1
kind: Secret
metadata:
  name: postgres-secrets
  namespace: railway
  labels:
    app.kubernetes.io/name: postgres
    app.kubernetes.io/component: database
type: Opaque
stringData:
  # Copy this file to secrets.yaml and replace every placeholder before apply.
  # The real secrets.yaml is ignored by Git and must never be committed.
  POSTGRES_DB: "railway_db"
  POSTGRES_USER: "YOUR_DB_USER"
  POSTGRES_PASSWORD: "REPLACE_WITH_A_LONG_RANDOM_PASSWORD"
