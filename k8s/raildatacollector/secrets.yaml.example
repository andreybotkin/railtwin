# Copy this file to secrets.yaml, fill in real values, and apply with:
#   kubectl apply -f k8s/raildatacollector/secrets.yaml -n railway
#
# Values must be base64-encoded:  echo -n "value" | base64
#
# Do NOT commit secrets.yaml to version control.

apiVersion: v1
kind: Secret
metadata:
  name: raildatacollector-secrets
  namespace: railway
type: Opaque
data:
  DATABASE_URL: <base64-encoded postgresql+asyncpg://user:pass@postgres-service:5432/railway_db>
  REDIS_URL: <base64-encoded redis://redis-service:6379/0>
