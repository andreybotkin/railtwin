# GitHub Container Registry imagePullSecret
#
# Создать Personal Access Token (PAT) на GitHub:
#   https://github.com/settings/tokens → New token → scope: read:packages
#
# Способ 1 — kubectl create secret (рекомендуется):
#   kubectl create secret docker-registry ghcr-registry-secret \
#     --docker-server=ghcr.io \
#     --docker-username=<github-username> \
#     --docker-password=<github-pat-token> \
#     -n railway
#
# Способ 2 — манифест ниже (base64 значения заполнить вручную):
#   Сгенерировать .dockerconfigjson:
#     echo -n '{"auths":{"ghcr.io":{"username":"<user>","password":"<token>","auth":"<base64(user:token)>"}}}' | base64 -w0
#
# Do NOT commit this file with real credentials.

apiVersion: v1
kind: Secret
metadata:
  name: ghcr-registry-secret
  namespace: railway
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: <base64-encoded-dockerconfigjson>
