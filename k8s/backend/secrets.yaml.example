apiVersion: v1
kind: Secret
metadata:
  name: backend-secrets
  namespace: railway
  labels:
    app.kubernetes.io/name: backend
    app.kubernetes.io/component: api
type: Opaque
stringData:
  # IMPORTANT: Replace these placeholder values before deployment!

  # Application secrets
  SECRET_KEY: "REPLACE_WITH_SECURE_SECRET_KEY"

  # Database connection
  DATABASE_URL: "postgresql+asyncpg://YOUR_DB_USER:YOUR_DB_PASSWORD@postgres-service.railway.svc.cluster.local:5432/railway_db"
  POSTGRES_DB: "railway_db"
  POSTGRES_USER: "YOUR_DB_USER"
  POSTGRES_PASSWORD: "YOUR_DB_PASSWORD"

  # Redis connection
  REDIS_URL: "redis://redis-service.railway.svc.cluster.local:6379/0"

  # Site domain and public URLs
  SITE_DOMAIN: "rthfi.com"
  API_URL: "https://api.rthfi.com"
  WS_URL: "wss://api.rthfi.com"

  # Next.js public env (used as build-args in CI)
  NEXT_PUBLIC_API_URL: "https://api.rthfi.com"
  NEXT_PUBLIC_WS_URL: "wss://api.rthfi.com"
