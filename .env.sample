# ==============================
# Shared project configuration
# ==============================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# ==============================
# Backend
# ==============================
APP_NAME=Thailand Railway Digital Twin
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
RATE_LIMIT_PER_MINUTE=100
WS_HEARTBEAT_INTERVAL=5
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Local compose runtime URLs
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/railway_db
REDIS_URL=redis://redis:6379/0
BACKEND_URL=http://backend:8000
WS_POLL_INTERVAL=2

# ==============================
# Frontend public runtime
# ==============================
NEXT_PUBLIC_API_URL=http://localhost:8002
NEXT_PUBLIC_WS_URL=ws://localhost:8002

# ==============================
# Local infrastructure
# ==============================
POSTGRES_DB=railway_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
GATEWAY_PORT=8002
FRONTEND_PORT=3000

# Optional helper tools (compose profile: tools)
PGADMIN_PORT=5050
REDIS_COMMANDER_PORT=8081
